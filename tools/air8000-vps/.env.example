DOMAIN=airsim.example.com
DEVICE_DOMAIN=device.airsim.example.com
ENROLL_DOMAIN=enroll.airsim.example.com
ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ADMIN_TOKEN
ENROLLMENT_TOKEN=REPLACE_WITH_A_ONE_TIME_ENROLLMENT_TOKEN
# One unique secret per device. Keep this file private.
DEVICE_REGISTRY_JSON={"air8000-device-1":{"secret":"REPLACE_WITH_DEVICE_SECRET"}}

# Public/LAN IPv4 reachable directly by the Air8000 for real carrier RTP media.
# Cloudflare proxying does not carry this UDP traffic.
RTP_PUBLIC_HOST=REPLACE_WITH_VPS_OR_LAN_IPV4
RTP_PORT_BASE=41000
RTP_PORT_COUNT=64
# LAN SIP signaling endpoint for the stock Air8000 CC<->SIP bridge.
# Keep UDP 5060 private; Cloudflare does not proxy SIP or RTP UDP.
SIP_PORT=5060
SIP_DOMAIN=airsim.local

# iOS app cloud Relay. In the app, set the Relay URL to
#   https://<DOMAIN>/ios/<IOS_ACCESS_TOKEN>
# IOS_ACCESS_TOKEN gates the whole iOS API: use 32+ random URL-safe chars.
IOS_ACCESS_TOKEN=REPLACE_WITH_A_LONG_RANDOM_URL_SAFE_TOKEN
IOS_PUBLIC_URL=https://airsim.example.com
# Optional: which Air8000 the iPhone controls (default: the connected one).
IOS_AIR8000_DEVICE_ID=
# Your own main app Bundle ID (not com.example.airsim).
ALLOWED_BUNDLE_ID=REPLACE_WITH_YOUR_APP_BUNDLE_ID
# APNs auth key (.p8) from your Apple Developer account. Put the PEM on one
# line with literal \n between lines. Keep this file private.
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_P8=
