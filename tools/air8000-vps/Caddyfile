# Only the mTLS device hostname may set X-Client-*; strip spoofed copies elsewhere.
{$DOMAIN} {
  reverse_proxy gateway:8080 {
    header_up -X-Client-Verify
    header_up -X-Client-Subject
  }
}

{$ENROLL_DOMAIN} {
  reverse_proxy gateway:8080 {
    header_up -X-Client-Verify
    header_up -X-Client-Subject
  }
}

{$DEVICE_DOMAIN} {
  tls {
    client_auth {
      mode require_and_verify
      trust_pool file /data/pki/device-ca.pem
    }
  }
  reverse_proxy gateway:8080 {
    header_up X-Client-Verify {http.request.tls.client.verifier}
    header_up X-Client-Subject {http.request.tls.client.subject}
  }
}
